<!-- XVV interface by iflaholmaz (@iflaholmaz). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XVV" Width="1180" Height="760" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#090B12" Foreground="#F6F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI" ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#111521"/>
    <SolidColorBrush x:Key="Panel2" Color="#181D2B"/>
    <SolidColorBrush x:Key="Accent" Color="#7C5CFC"/>
    <SolidColorBrush x:Key="Muted" Color="#8E96A8"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F7F8FC"/><Setter Property="Background" Value="#1A2030"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="16,13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><Viewbox Width="17" Height="17" Margin="0,0,12,0"><Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="#B9C5E2" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F1F3F8"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,7"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F6F7FB"/><Setter Property="Background" Value="#151A28"/><Setter Property="BorderBrush" Value="#283047"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="LanguageButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="TweakToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Track" Background="#30384A" CornerRadius="11" Padding="2"><Grid><Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#D7DCE8" HorizontalAlignment="Left"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#7C5CFC"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/><Setter Property="Foreground" Value="#7C5CFC"/><Setter Property="Background" Value="#202638"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#F6F7FB"/><Setter Property="Background" Value="#151A28"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="11,7"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0D1019" BorderBrush="#202638" BorderThickness="0,0,1,0">
      <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="5,12,5,28">
          <TextBlock Text="XVV" FontSize="34" FontWeight="Bold" Foreground="#9D87FF"/>
          <TextBlock Text="Windows Control Center" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="NavHome" Style="{StaticResource NavButton}" Content="Ana Sayfa" Tag="M3,10 L10,3 L17,10 M5,9 V17 H15 V9 M8,17 V12 H12 V17" Background="#292047"/>
          <Button x:Name="NavCleanup" Style="{StaticResource NavButton}" Content="Temizlik" Tag="M4,4 L16,16 M14,3 L17,6 M3,14 L6,17 M10,2 L10,5 M2,10 L5,10"/>
          <Button x:Name="NavApps" Style="{StaticResource NavButton}" Content="Uygulamalar" Tag="M3,3 H8 V8 H3 Z M12,3 H17 V8 H12 Z M3,12 H8 V17 H3 Z M12,12 H17 V17 H12 Z"/>
          <Button x:Name="NavInstall" Style="{StaticResource NavButton}" Content="Hızlı Kurulum" Tag="M10,2 V13 M6,9 L10,13 L14,9 M3,15 V18 H17 V15"/>
          <Button x:Name="NavFps" Style="{StaticResource NavButton}" Content="FPS Ayarları" Tag="M3,14 L7,10 L10,12 L15,5 M13,5 H15 V7 M4,17 H16"/>
          <Button x:Name="NavSpecs" Style="{StaticResource NavButton}" Content="PC Özellikleri" Tag="M3,5 H17 V15 H3 Z M7,18 H13 M10,15 V18 M6,8 H9 V11 H6 Z M12,8 H14"/>
          <Button x:Name="NavTools" Style="{StaticResource NavButton}" Content="Hızlı Araçlar" Tag="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M10,7 A3,3 0 1 0 10,13 A3,3 0 1 0 10,7 M10,1 V4 M10,16 V19 M1,10 H4 M16,10 H19"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#141927" CornerRadius="12" Padding="5" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="LanguageTrButton" Style="{StaticResource LanguageButton}" Content="TR" Background="#7C5CFC"/><Button x:Name="LanguageEnButton" Grid.Column="1" Style="{StaticResource LanguageButton}" Content="EN"/></Grid></Border>
        <Border Grid.Row="3" Background="#141927" CornerRadius="12" Padding="12">
          <StackPanel><TextBlock x:Name="AdminBadge" FontWeight="SemiBold"/><TextBlock Text="XVV Stable | iflaholmaz" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="34,28">
      <Grid x:Name="PageHome">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="4,2,0,18"><Border Background="#2B2350" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left"><TextBlock x:Name="HomeHeroBadge" Text="iflaholmaz | XVV CONTROL" Foreground="#B9AAFF" FontSize="10" FontWeight="Bold"/></Border><TextBlock x:Name="HomeTitle" Text="Merhaba." FontSize="31" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock x:Name="HomeSubtitle" Text="Windows bakımı, kurulum ve ince ayarlar tek kontrol merkezinde." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" CornerRadius="17" Padding="22,18" BorderBrush="#493C7A" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1E1838" Offset="0"/><GradientStop Color="#111827" Offset="0.55"/><GradientStop Color="#102331" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="OsLabel" Text="İŞLETİM SİSTEMİ" Foreground="#A996FF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="OsText" FontSize="19" FontWeight="SemiBold" Margin="0,6,15,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="DiskLabel" Text="BOŞ DİSK ALANI" Foreground="#72D6BE" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DiskText" FontSize="17" FontWeight="SemiBold" Margin="0,6,15,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="UptimeLabel" Text="ÇALIŞMA SÜRESİ" Foreground="#7FB7FF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="UptimeText" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Grid></Border>
        <StackPanel Grid.Row="2" Margin="4,22,0,13"><TextBlock x:Name="HomeCardTitle" Text="Kontrolü eline al" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="HomeCardSubtitle" Text="Başlamak istediğin bölümü seç." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
        <UniformGrid Grid.Row="3" Columns="2" Rows="2" Margin="-6">
          <Border Background="#121725" BorderBrush="#2B3450" BorderThickness="1" CornerRadius="15" Padding="18" Margin="6"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="HomeSafetyTitle" Text="AKILLI TEMİZLİK" Foreground="#64D8A0" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="HomeSafetyText" Text="Geçici dosyaları önce tara, boyutlarını gör ve yalnız seçtiklerini temizle." Foreground="#9DA8BE" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,12"/></StackPanel><Button Grid.Row="1" x:Name="HomeScanButton" Content="Temizliği Aç" Background="#1E5548" HorizontalAlignment="Stretch"/></Grid></Border>
          <Border Background="#121725" BorderBrush="#352D57" BorderThickness="1" CornerRadius="15" Padding="18" Margin="6"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="HomeCatalogTitle" Text="HIZLI KURULUM" Foreground="#B9AAFF" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="HomeCatalogText" Text="Format sonrası uygulamaları Winget ile güncel sürümlerinden topluca kur." Foreground="#9DA8BE" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,12"/></StackPanel><Button Grid.Row="1" x:Name="HomeInstallButton" Content="Kurulumu Aç" Background="#392B68" HorizontalAlignment="Stretch"/></Grid></Border>
          <Border Background="#121725" BorderBrush="#3B315F" BorderThickness="1" CornerRadius="15" Padding="18" Margin="6"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="HomeTweaksTitle" Text="WINDOWS AYARLARI" Foreground="#A996FF" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="HomeTweaksText" Text="40 oyun, gizlilik, Explorer ve arayüz ayarını yedekleyerek uygula." Foreground="#9DA8BE" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,12"/></StackPanel><Button Grid.Row="1" x:Name="HomeFpsButton" Content="Ayarları Aç" Background="#49358C" HorizontalAlignment="Stretch"/></Grid></Border>
          <Border Background="#121725" BorderBrush="#28435A" BorderThickness="1" CornerRadius="15" Padding="18" Margin="6"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="HomeQuickTitle" Text="PC ÖZELLİKLERİ" Foreground="#7FB7FF" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="HomeQuickSubtitle" Text="İşlemci, ekran kartı, anakart, RAM, disk ve monitör ayrıntılarını incele." Foreground="#9DA8BE" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,12"/></StackPanel><Button Grid.Row="1" x:Name="HomeSpecsButton" Content="Bilgileri Aç" Background="#1F3E59" HorizontalAlignment="Stretch"/></Grid></Border>
        </UniformGrid>
      </Grid>

      <Grid x:Name="PageCleanup" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="CleanupTitle" Text="Akıllı Temizlik" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="CleanupSubtitle" Text="Temizlemek istediklerini seç. Önce tarama yapabilirsin." Foreground="{StaticResource Muted}" Margin="0,6,0,18"/></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="16" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CleanupOptions"/></ScrollViewer></Border>
        <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="CleanupStatus" Text="Henüz taranmadı" FontWeight="SemiBold"/><TextBlock x:Name="CleanupDetail" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
          <Button Grid.Column="1" x:Name="ScanButton" Content="Tara" Margin="8,0"/>
          <Button Grid.Column="2" x:Name="CleanButton" Content="Seçilenleri Temizle" Background="{StaticResource Accent}" Margin="8,0,0,0"/>
        </Grid>
      </Grid>

      <Grid x:Name="PageApps" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="AppsTitle" Text="Windows Uygulamaları" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="AppsSubtitle" Text="Kutucukları işaretle ve seçtiğin uygulamaları tek işlemle kaldır." Foreground="{StaticResource Muted}" Margin="0,6,0,16"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AppSearch" ToolTip="Uygulama ara"/><Button Grid.Column="1" x:Name="ClearAppSelectionButton" Content="Seçimi Temizle" Margin="12,0,0,0"/><Button Grid.Column="2" x:Name="RefreshAppsButton" Content="Yenile" Margin="8,0,0,0"/></Grid>
        <ListBox Grid.Row="2" x:Name="AppsList" Background="{StaticResource Panel}" BorderThickness="0" SelectionMode="Multiple" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate><DataTemplate><Grid Margin="10,7"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/><Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Background="#242A3B"><Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform"/></Border><StackPanel Grid.Column="2" Margin="10,0"><TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#F6F7FB"/><TextBlock Text="{Binding PackageName}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="AppsStatus" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><Button x:Name="RemoveAppsButton" Content="Seçilenleri Kaldır" Background="#D84C6F" HorizontalAlignment="Right"/></Grid>
      </Grid>

      <Grid x:Name="PageInstall" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="InstallTitle" Text="Hızlı Kurulum" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="InstallSubtitle" Text="Format sonrası gereken uygulamaları seç; en güncel sürümleri Winget ile topluca kur." Foreground="{StaticResource Muted}" Margin="0,6,0,16"/></StackPanel>
        <TextBox Grid.Row="1" x:Name="InstallSearch" ToolTip="Uygulama ara" Margin="0,0,0,12"/>
        <WrapPanel Grid.Row="2" Margin="0,0,0,12"><Button x:Name="InstallCatAll" Content="Tümü" Background="#7C5CFC" Margin="0,0,7,0" Padding="13,7"/><Button x:Name="InstallCatGames" Content="Oyunlar" Margin="0,0,7,0" Padding="13,7"/><Button x:Name="InstallCatBrowsers" Content="Tarayıcılar" Margin="0,0,7,0" Padding="13,7"/><Button x:Name="InstallCatSecurity" Content="Güvenlik" Margin="0,0,7,0" Padding="13,7"/><Button x:Name="InstallCatCommunication" Content="İletişim" Margin="0,0,7,0" Padding="13,7"/><Button x:Name="InstallCatMedia" Content="Video ve Medya" Margin="0,0,7,0" Padding="13,7"/><Button x:Name="InstallCatTools" Content="Araçlar" Padding="13,7"/></WrapPanel>
        <ListBox Grid.Row="3" x:Name="InstallList" Background="{StaticResource Panel}" BorderThickness="0" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate><Grid Margin="12,7"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="46"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/><Border Grid.Column="1" Width="36" Height="36" CornerRadius="9" Background="#242A3B" BorderBrush="#303950" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{Binding IconUrl}" Width="27" Height="27" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2" Margin="11,0,14,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="#F6F7FB" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="3" Background="#292047" CornerRadius="8" Padding="10,4" VerticalAlignment="Center"><TextBlock Text="{Binding Category}" Foreground="#B9AAFF" FontSize="11" FontWeight="SemiBold"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="48"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="InstallStatus" Text="Kuruluma hazır" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" x:Name="InstallProgress" Minimum="0" Maximum="100" Value="0" Margin="12,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" x:Name="InstallProgressText" Foreground="#B9AAFF" VerticalAlignment="Center"/><Button Grid.Column="3" x:Name="ClearInstallSelectionButton" Content="Seçimi Temizle" Margin="8,0"/><Button Grid.Column="4" x:Name="InstallSelectedButton" Content="Seçilenleri Kur" Background="{StaticResource Accent}"/><TextBlock Grid.Row="1" Grid.ColumnSpan="5" x:Name="InstallNote" Text="Sürüm belirtilmez; Winget kaynağındaki en güncel sürüm indirilir." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/></Grid>
      </Grid>

      <Grid x:Name="PageFps" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border CornerRadius="20" Padding="24,20" Margin="0,0,0,14"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#35256D" Offset="0"/><GradientStop Color="#161B2D" Offset="0.62"/><GradientStop Color="#12243A" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Border Background="#49358C" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left"><TextBlock x:Name="FpsHeroBadge" Text="XVV TWEAK LAB" Foreground="#D9D0FF" FontSize="10" FontWeight="Bold"/></Border><TextBlock x:Name="FpsTitle" Text="Oyun ve Regedit Ayarları" FontSize="29" FontWeight="Bold" Margin="0,10,0,0"/><TextBlock x:Name="FpsSubtitle" Text="Her ayarı ayrı seç; kayıt değişikliğini gör ve güvenle geri al." Foreground="#B7C1D8" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="FpsSelectedCount" Text="0 seçili" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="FpsSafetyBadge" Text="● Geri yükleme korumalı" Foreground="#64D8A0" Margin="0,5,0,0"/></StackPanel></Grid></Border>
        <Border Grid.Row="1" Background="#111725" BorderBrush="#252E43" BorderThickness="1" CornerRadius="13" Padding="14,10" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock x:Name="FpsQuickLabel" Text="Hızlı seçim:" VerticalAlignment="Center" Foreground="#AAB2C3" FontWeight="SemiBold" Margin="0,0,12,0"/><Button x:Name="FpsPresetRecommended" Content="Önerilen" Background="#7C5CFC" Padding="12,7" Margin="0,0,6,0"/><Button x:Name="FpsPresetCompetitive" Content="Rekabetçi" Padding="12,7" Margin="0,0,6,0"/><Button x:Name="FpsPresetLowEnd" Content="Düşük Sistem" Padding="12,7" Margin="0,0,6,0"/><Button x:Name="FpsPresetPrivacy" Content="Gizlilik" Padding="12,7" Margin="0,0,6,0"/><Button x:Name="FpsPresetWindows" Content="Windows" Padding="12,7" Margin="0,0,6,0"/><Button x:Name="FpsPresetClear" Content="Temizle" Padding="12,7"/></StackPanel></Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#101520" BorderBrush="#252D42" BorderThickness="1" CornerRadius="15" Padding="14" Margin="0,0,7,0"><StackPanel><TextBlock x:Name="FpsPerformanceSectionTitle" Text="Oyun, Sistem ve Explorer" FontSize="18" FontWeight="Bold" Margin="2,0,0,12"/><StackPanel x:Name="FpsPerformanceOptions"/></StackPanel></Border><Border Grid.Column="1" Background="#101520" BorderBrush="#252D42" BorderThickness="1" CornerRadius="15" Padding="14" Margin="7,0,0,0"><StackPanel><TextBlock x:Name="FpsWindowsSectionTitle" Text="Gizlilik ve Arayüz" FontSize="18" FontWeight="Bold" Margin="2,0,0,12"/><StackPanel x:Name="FpsWindowsOptions"/></StackPanel></Border></Grid></ScrollViewer>
        <Border Grid.Row="3" Background="#121725" BorderBrush="#252D42" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/><ColumnDefinition Width="44"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="FpsStatus" Text="Ayar seçmeye hazır" FontWeight="SemiBold"/><TextBlock x:Name="FpsRestartNote" Text="Bazı değişiklikler yeniden oturum açınca etkili olur." Foreground="#74809A" FontSize="11" Margin="0,3,0,0"/></StackPanel><ProgressBar Grid.Column="1" x:Name="FpsProgress" Minimum="0" Maximum="100" Value="0" Margin="10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" x:Name="FpsProgressText" Foreground="#B9AAFF" VerticalAlignment="Center"/><Button Grid.Column="3" x:Name="RestoreFpsButton" Content="Son Ayarları Geri Al" Margin="8,0"/><Button Grid.Column="4" x:Name="ApplyFpsButton" Content="Seçilenleri Uygula" Background="{StaticResource Accent}"/></Grid></Border>
      </Grid>

      <Grid x:Name="PageSpecs" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="SpecsTitle" Text="PC Özellikleri" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="SpecsSubtitle" Text="Bulması zor donanım ve sistem bilgilerini tek yerde görüntüle." Foreground="{StaticResource Muted}" Margin="0,6,0,18"/></StackPanel>
        <UniformGrid Grid.Row="1" Columns="4" Rows="3" Margin="-5,0,-5,12">
          <Button x:Name="SpecCpu" Content="İşlemci" Margin="5"/><Button x:Name="SpecGpu" Content="Ekran Kartı" Margin="5"/><Button x:Name="SpecBoard" Content="Anakart ve BIOS" Margin="5"/><Button x:Name="SpecRam" Content="RAM" Margin="5"/>
          <Button x:Name="SpecDisk" Content="Diskler" Margin="5"/><Button x:Name="SpecMonitor" Content="Monitörler" Margin="5"/><Button x:Name="SpecNetwork" Content="Ağ" Margin="5"/><Button x:Name="SpecSystem" Content="Windows" Margin="5"/>
